{
  "name": "Nightshelf",
  "short_name": "Nightshelf",
  "description": "Dein Regal für Spiele, Serien, Anime, Manga und Filme – mit Trophäen.",
  "id": "/nightshelf/",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0E0B16",
  "theme_color": "#0E0B16",
  "lang": "de",
  "categories": ["entertainment", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Demnächst", "url": "./#/upcoming", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Anime", "url": "./#/anime", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Manga", "url": "./#/manga", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Spiele", "url": "./#/games", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
